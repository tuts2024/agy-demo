# ==============================================================================
# Enterprise SDLC Autonomous Code Review & Remediation — Environment Configuration
# Configured for GCP Project: lean-w-me | Vertex AI Model Garden
# ==============================================================================

# 1. Google Cloud Vertex AI Model Garden
GCP_PROJECT="lean-w-me"
GCP_LOCATION="us-central1"
VERTEX_AI_MODEL="gemini-2.0-flash" # Options: gemini-2.0-flash, gemini-2.5-pro, gemini-1.5-pro

# Optional: Google AI Studio Gemini API Key fallback (if not using ADC)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# 2. GitHub API Integration
GITHUB_TOKEN=""
GITHUB_REPOSITORY="your-org/your-repo"

# 3. Atlassian Jira Cloud Integration
ATLASSIAN_HOST="https://your-company.atlassian.net"
ATLASSIAN_EMAIL="service-account@your-company.com"
ATLASSIAN_API_TOKEN=""
JIRA_PROJECT_KEY="PAY"
